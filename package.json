{
  "name": "praxis-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs *.ts *.mjs package.json README.md",
    "format:check": "prettier --check src scripts tests docs *.ts *.mjs package.json README.md",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:zoom": "node scripts/check-browser-zoom.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:launch": "node scripts/verify-content.mjs --launch",
    "audit:performance": "node scripts/audit-performance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
